    "cluster:dev": "nodemon src/cluster.ts",
    "worker:dev": "nodemon src/worker.ts",
    "worker:prod": "node dist/worker.js",
    "build": "tsc -p .",
    "deploy": "npm install && npm run build && npm run db:migrate",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:generate": "drizzle-kit generate",
    "db:drop": "drizzle-kit drop",
    "db:migrate": "npx drizzle-kit migrate --config=drizzle.config.ts",
    "db:seed": "ts-node src/seeds/index.ts",
    "copy-views": "cp -R src/views dist/views",
    "test:load": "k6 run loadtest.js"
  },
